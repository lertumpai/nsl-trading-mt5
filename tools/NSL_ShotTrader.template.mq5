// Generated by tools/train_ea.py. Weights are train-only; tuning uses 2024 only.
#property strict
#property version "1.00"
#property description "NSL closed-bar price-action EA with embedded per-pair learned filters."
#include <Trade/Trade.mqh>

input double RiskPercent=0.25;     // Equity risk per position, per chart
input bool EnableOrders=false;    // Research run failed validation; enable only for deliberate testing
input long MagicNumber=2601108;
input double ThresholdOverride=-1; // -1 uses frozen validation-selected threshold
input bool AllowLiveAccount=false; // Demo and Strategy Tester allowed by default
input int MaxQuoteAgeSeconds=10;

double ModelMean[3][19]=@MEANS@;
double ModelScale[3][19]=@SCALES@;
double ModelBeta[3][20]=@COEFFICIENTS@;
double ModelThreshold[3]=@THRESHOLDS@;

struct Context
{
   MqlRates bar,previous;
   double atr,ema9,ema21,rsi,volume_ratio;
   double high,low,prev_high,prev_low,pull_low,pull_high;
   datetime high_known,low_known,bo_up_known,bo_down_known;
   double bo_up,bo_down;
   bool up,down,bear_recent,bull_recent,continuous;
};

CTrade Trader;
int PairIndex=-1;
datetime LastBar=0,Started=0,LastSignal[8],UsedAnchor[8];
Context C1,C5,C15;

bool LoadContext(ENUM_TIMEFRAMES tf,Context &out)
{
   MqlRates bars[];
   ArraySetAsSeries(bars,false);
   int n=CopyRates(_Symbol,tf,1,1200,bars);
   if(n<1200) return false;
   ZeroMemory(out);
   double a=0,e9=0,e21=0,gain=0,loss=0;
   double last_hi=0,last_lo=0,prev_hi=0,prev_lo=0;
   datetime hi_known=0,lo_known=0;
   int seconds=PeriodSeconds(tf);
   for(int i=0;i<n;i++)
   {
      double old_hi=last_hi,old_lo=last_lo;
      double tr=bars[i].high-bars[i].low;
      if(i>0) tr=MathMax(tr,MathMax(MathAbs(bars[i].high-bars[i-1].close),MathAbs(bars[i].low-bars[i-1].close)));
      if(i<14) a+=tr/14.; else a=(13*a+tr)/14.;
      if(i<9) e9+=bars[i].close/9.; else e9+=(bars[i].close-e9)*0.2;
      if(i<21) e21+=bars[i].close/21.; else e21+=(bars[i].close-e21)/11.;
      if(i>0)
      {
         double delta=bars[i].close-bars[i-1].close;
         if(i<=14) {gain+=MathMax(delta,0)/14.;loss+=MathMax(-delta,0)/14.;}
         else {gain=(13*gain+MathMax(delta,0))/14.;loss=(13*loss+MathMax(-delta,0))/14.;}
      }
      if(i>=4)
      {
         bool contiguous=true;
         for(int z=i-3;z<=i;z++) if(bars[z].time-bars[z-1].time!=seconds) contiguous=false;
         int p=i-2;
         if(contiguous)
         {
            if(bars[p].high>bars[p-2].high && bars[p].high>bars[p-1].high && bars[p].high>bars[p+1].high && bars[p].high>bars[p+2].high)
            {prev_hi=last_hi;last_hi=bars[p].high;hi_known=bars[i].time+seconds;}
            if(bars[p].low<bars[p-2].low && bars[p].low<bars[p-1].low && bars[p].low<bars[p+1].low && bars[p].low<bars[p+2].low)
            {prev_lo=last_lo;last_lo=bars[p].low;lo_known=bars[i].time+seconds;}
         }
      }
      if(i>=21 && a>0)
      {
         double range=bars[i].high-bars[i].low;
         bool strong=(range>0 && MathAbs(bars[i].close-bars[i].open)/range>=0.6 && range/a>=1);
         if(strong && old_hi>0 && bars[i].close>old_hi+0.1*a && bars[i-1].close<=old_hi+0.1*a)
         {out.bo_up=old_hi;out.bo_up_known=bars[i].time+seconds;}
         if(strong && old_lo>0 && bars[i].close<old_lo-0.1*a && bars[i-1].close>=old_lo-0.1*a)
         {out.bo_down=old_lo;out.bo_down_known=bars[i].time+seconds;}
      }
   }
   out.bar=bars[n-1];out.previous=bars[n-2];
   out.atr=a;out.ema9=e9;out.ema21=e21;
   out.rsi=(loss>0 ? 100-100/(1+gain/loss) : (gain>0 ? 100 : 50));
   double volume=0;for(int i=n-21;i<n-1;i++) volume+=(double)bars[i].tick_volume;
   if(a<=0 || volume<=0 || prev_hi<=0 || prev_lo<=0) return false;
   out.volume_ratio=(double)bars[n-1].tick_volume/(volume/20.);
   out.high=last_hi;out.low=last_lo;out.prev_high=prev_hi;out.prev_low=prev_lo;
   out.high_known=hi_known;out.low_known=lo_known;
   out.up=(last_hi>prev_hi && last_lo>prev_lo);
   out.down=(last_hi<prev_hi && last_lo<prev_lo);
   out.pull_low=bars[n-1].low;out.pull_high=bars[n-1].high;
   for(int i=n-3;i<n;i++)
   {
      out.pull_low=MathMin(out.pull_low,bars[i].low);out.pull_high=MathMax(out.pull_high,bars[i].high);
      if(bars[i].close<bars[i].open) out.bear_recent=true;
      if(bars[i].close>bars[i].open) out.bull_recent=true;
   }
   out.continuous=true;
   for(int i=n-24;i<n;i++) if(bars[i].time-bars[i-1].time!=seconds) out.continuous=false;
   int window=(tf==PERIOD_M1 ? 240 : (tf==PERIOD_M5 ? 288 : 480));
   int days=(tf==PERIOD_M1 ? 3 : (tf==PERIOD_M5 ? 5 : 14));
   if(bars[n-1].time+seconds-bars[n-window].time>days*86400) return false;
   return true;
}

void AppendFeatures(Context &c,double &x[],int offset)
{
   x[offset]=(c.bar.close-c.bar.open)/c.atr;
   x[offset+1]=(c.bar.high-c.bar.low)/c.atr;
   x[offset+2]=(c.bar.close-c.ema21)/c.atr;
   x[offset+3]=(c.ema9-c.ema21)/c.atr;
   x[offset+4]=(c.rsi-50)/50.;
   x[offset+5]=c.volume_ratio;
}

double Score()
{
   double x[19];AppendFeatures(C1,x,0);AppendFeatures(C5,x,6);AppendFeatures(C15,x,12);
   x[18]=(double)C1.bar.spread*_Point/C1.atr;
   double z=ModelBeta[PairIndex][0];
   for(int i=0;i<19;i++)
   {
      double v=MathMax(-8,MathMin(8,(x[i]-ModelMean[PairIndex][i])/ModelScale[PairIndex][i]));
      if(!MathIsValidNumber(v)) return -1;
      z+=ModelBeta[PairIndex][i+1]*v;
   }
   return 1./(1.+MathExp(-MathMax(-35,MathMin(35,z))));
}

// Pattern order matches manifest sorting for simultaneous decisions.
bool Setup(int pattern,bool buy,datetime decision,datetime &anchor)
{
   double a=C1.atr,h=C1.bar.high,l=C1.bar.low,c=C1.bar.close;
   bool bull=c>C1.bar.open,bear=c<C1.bar.open;
   bool confirm=(buy ? c>C1.previous.high : c<C1.previous.low);
   if(!confirm || (buy ? !bull : !bear)) return false;
   if(pattern==0) // breakout_retest
   {
      anchor=(buy ? C5.bo_up_known : C5.bo_down_known);
      if(anchor==0 || decision<=anchor || decision-anchor>900) return false;
      return buy ? (l<=C5.bo_up+0.1*a && l>=C5.bo_up-0.25*a && c>C5.bo_up+0.1*a)
                 : (h>=C5.bo_down-0.1*a && h<=C5.bo_down+0.25*a && c<C5.bo_down-0.1*a);
   }
   if(pattern==1) // range_rejection
   {
      anchor=(buy ? C15.low_known : C15.high_known);
      double rh=MathMax(C15.high,C15.prev_high),rl=MathMin(C15.low,C15.prev_low);
      if(MathAbs(C15.high-C15.prev_high)>0.3*C15.atr || MathAbs(C15.low-C15.prev_low)>0.3*C15.atr || rh-rl<2*C15.atr) return false;
      return buy ? (l<=rl+0.15*C15.atr && c>rl+0.05*C15.atr) : (h>=rh-0.15*C15.atr && c<rh-0.05*C15.atr);
   }
   anchor=(buy ? C5.low_known : C5.high_known);
   if(pattern==2) // sweep_reclaim
      return buy ? (C1.previous.close>=C5.low && l<C5.low-0.15*a && c>C5.low+0.1*a && MathMin(C1.bar.open,c)-l>=0.25*(h-l))
                 : (C1.previous.close<=C5.high && h>C5.high+0.15*a && c<C5.high-0.1*a && h-MathMax(C1.bar.open,c)>=0.25*(h-l));
   return buy ? (C15.up && C5.up && C5.bear_recent && C5.pull_low<=C5.low+0.3*C5.atr && C5.pull_low>=C5.low-0.1*C5.atr && C5.bar.close>C5.low)
              : (C15.down && C5.down && C5.bull_recent && C5.pull_high>=C5.high-0.3*C5.atr && C5.pull_high<=C5.high+0.1*C5.atr && C5.bar.close<C5.high);
}

bool Plan(int pattern,bool buy,double &entry,double &sl,double &tp)
{
   double buffer=MathMax(_Point,0.1*C1.atr),spread=MathMax(0,C1.bar.spread)*_Point;
   entry=buy ? C1.bar.high+MathMax(buffer,spread+_Point) : C1.bar.low-buffer;
   sl=buy ? MathMin(C1.bar.low,C5.pull_low)-buffer : MathMax(C1.bar.high,C5.pull_high)+spread+buffer;
   if(pattern==1)
      tp=(MathMax(C15.high,C15.prev_high)+MathMin(C15.low,C15.prev_low))/2.;
   else
   {
      double x=buy ? C5.high : C5.low,y=buy ? C15.high : C15.low;
      bool vx=buy ? x>entry : x<entry,vy=buy ? y>entry : y<entry;
      if(!vx && !vy) return false;
      tp=vx && vy ? (buy ? MathMin(x,y) : MathMax(x,y)) : (vx ? x : y);
   }
   return buy ? sl<entry && entry<tp : tp<entry && entry<sl;
}

bool HasExposure()
{
   // Respect any position/order on this symbol, including other EAs or manual trades.
   for(int i=PositionsTotal()-1;i>=0;i--) if(PositionGetSymbol(i)==_Symbol) return true;
   for(int i=OrdersTotal()-1;i>=0;i--) if(OrderGetTicket(i)>0 && OrderGetString(ORDER_SYMBOL)==_Symbol) return true;
   return false;
}

bool TradeOK(bool local_ok)
{
   uint r=Trader.ResultRetcode();
   if(local_ok && (r==TRADE_RETCODE_DONE || r==TRADE_RETCODE_PLACED || r==TRADE_RETCODE_DONE_PARTIAL)) return true;
   Print("Trade request failed: ",r," ",Trader.ResultRetcodeDescription());return false;
}

void Manage(MqlTick &tick)
{
   Trader.SetTypeFillingBySymbol(_Symbol);
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      ulong ticket=OrderGetTicket(i);
      if(ticket==0 || OrderGetString(ORDER_SYMBOL)!=_Symbol || OrderGetInteger(ORDER_MAGIC)!=MagicNumber) continue;
      long type=OrderGetInteger(ORDER_TYPE);
      if(type!=ORDER_TYPE_BUY_STOP && type!=ORDER_TYPE_SELL_STOP) continue;
      double sl=OrderGetDouble(ORDER_SL),maxspread=0;
      string comment=OrderGetString(ORDER_COMMENT);
      if(StringFind(comment,"NSL1|")==0) maxspread=StringToDouble(StringSubstr(comment,5));
      bool invalid=(type==ORDER_TYPE_BUY_STOP ? tick.bid<=sl : tick.ask>=sl);
      bool wide=(maxspread>0 && (tick.ask-tick.bid)/_Point>maxspread);
      if(tick.time-OrderGetInteger(ORDER_TIME_SETUP)>=180 || invalid || wide) TradeOK(Trader.OrderDelete(ticket));
   }
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong ticket=PositionGetTicket(i);
      if(ticket==0 || PositionGetString(POSITION_SYMBOL)!=_Symbol || PositionGetInteger(POSITION_MAGIC)!=MagicNumber) continue;
      if(tick.time-PositionGetInteger(POSITION_TIME)>=600) TradeOK(Trader.PositionClose(ticket));
   }
}

double RoundPrice(double price,bool up)
{
   double step=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE);
   if(step<=0) step=_Point;
   return NormalizeDouble((up ? MathCeil(price/step-1e-8) : MathFloor(price/step+1e-8))*step,_Digits);
}

void Submit(bool buy,double entry,double sl,double tp,double maxspread,MqlTick &tick)
{
   if(!EnableOrders) return;
   if(HasExposure()) return;
   if(!MQLInfoInteger(MQL_TESTER) && AccountInfoInteger(ACCOUNT_TRADE_MODE)==ACCOUNT_TRADE_MODE_REAL && !AllowLiveAccount) return;
   entry=RoundPrice(entry,buy);sl=RoundPrice(sl,!buy);tp=RoundPrice(tp,!buy);
   double distance=(double)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL)*_Point;
   if(buy ? (entry<=tick.ask || entry-tick.ask<distance || entry-sl<distance || tp-entry<distance)
          : (entry>=tick.bid || tick.bid-entry<distance || sl-entry<distance || entry-tp<distance)) return;
   double pnl=0;
   if(!OrderCalcProfit(buy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,_Symbol,1.,entry,sl,pnl) || pnl>=0) return;
   double budget=AccountInfoDouble(ACCOUNT_EQUITY)*RiskPercent/100.;
   double step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP),minimum=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);
   if(step<=0) return;
   double lots=MathFloor(MathMin(budget/(-pnl),SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX))/step)*step;
   lots=NormalizeDouble(lots,8);
   if(lots<minimum || lots<=0) return;
   double margin=0;
   if(!OrderCalcMargin(buy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,_Symbol,lots,entry,margin) || margin>AccountInfoDouble(ACCOUNT_MARGIN_FREE)*0.9) return;
   long expiry_mode=SymbolInfoInteger(_Symbol,SYMBOL_EXPIRATION_MODE);
   ENUM_ORDER_TYPE_TIME mode=ORDER_TIME_GTC;datetime expiration=0;
   if((expiry_mode & SYMBOL_EXPIRATION_SPECIFIED)!=0) {mode=ORDER_TIME_SPECIFIED;expiration=tick.time+180;}
   else if((expiry_mode & SYMBOL_EXPIRATION_GTC)==0) return;
   Trader.SetTypeFilling(ORDER_FILLING_RETURN);
   string comment="NSL1|"+DoubleToString(maxspread,2);
   bool ok=buy ? Trader.BuyStop(lots,entry,_Symbol,sl,tp,mode,expiration,comment)
               : Trader.SellStop(lots,entry,_Symbol,sl,tp,mode,expiration,comment);
   TradeOK(ok);
}

int OnInit()
{
   string s=_Symbol;
   if(StringFind(s,"EURUSD")>=0) PairIndex=0;
   else if(StringFind(s,"GBPUSD")>=0) PairIndex=1;
   else if(StringFind(s,"USDJPY")>=0) PairIndex=2;
   if(PairIndex<0 || RiskPercent<=0 || RiskPercent>5 || MagicNumber<=0 || MaxQuoteAgeSeconds<1 || (ThresholdOverride!=-1 && (ThresholdOverride<0 || ThresholdOverride>1))) return INIT_PARAMETERS_INCORRECT;
   Trader.SetExpertMagicNumber(MagicNumber);Trader.SetAsyncMode(false);
   ArrayInitialize(LastSignal,0);ArrayInitialize(UsedAnchor,0);
   Started=TimeCurrent();
   Print("NSL filter v1: ",s," threshold=",ModelThreshold[PairIndex],". Dataset scenario results are not live execution validation.");
   return INIT_SUCCEEDED;
}

void OnTick()
{
   MqlTick tick;if(!SymbolInfoTick(_Symbol,tick) || tick.bid<=0 || tick.ask<tick.bid) return;
   if(TimeCurrent()-tick.time>MaxQuoteAgeSeconds) return;
   Manage(tick);
   datetime bar=iTime(_Symbol,PERIOD_M1,0);
   if(bar==0 || bar==LastBar || tick.time-bar>5) return;
   // Retry asynchronously loading history within this minute's five-second window.
   if(!LoadContext(PERIOD_M1,C1)) return;
   if(C5.bar.time!=iTime(_Symbol,PERIOD_M5,1) && !LoadContext(PERIOD_M5,C5)) return;
   if(C15.bar.time!=iTime(_Symbol,PERIOD_M15,1) && !LoadContext(PERIOD_M15,C15)) return;
   LastBar=bar;
   if(C1.bar.time+60!=bar || C5.bar.time+300!=(bar/300)*300 || C15.bar.time+900!=(bar/900)*900 || !C1.continuous) return;
   if(tick.time-Started<900) return;
   double range=C1.bar.high-C1.bar.low;
   if(range<=0 || MathAbs(C1.bar.close-C1.bar.open)/range<0.55 || range/C1.atr<0.8 || range/C1.atr>2.5) return;
   double maxspread=MathMax(10,0.4*C1.atr/_Point);
   if(C1.bar.spread>maxspread) return;
   double probability=Score(),threshold=ThresholdOverride<0 ? ModelThreshold[PairIndex] : ThresholdOverride;
   bool chosen=false,buy_choice=false;double entry_choice=0,sl_choice=0,tp_choice=0;
   for(int p=0;p<4;p++) for(int side=0;side<2;side++)
   {
      bool buy=(side==0);datetime anchor=0;double entry=0,sl=0,tp=0;
      int id=2*p+side;
      if(!Setup(p,buy,bar,anchor) || !Plan(p,buy,entry,sl,tp)) continue;
      if(UsedAnchor[id]==anchor || (LastSignal[id]>0 && bar-LastSignal[id]<900)) continue;
      // Dedup precedes the ML filter and account exposure check, as in extraction.
      UsedAnchor[id]=anchor;LastSignal[id]=bar;
      if(!chosen && probability>=threshold)
      {chosen=true;buy_choice=buy;entry_choice=entry;sl_choice=sl;tp_choice=tp;}
   }
   if(chosen && (tick.ask-tick.bid)/_Point<=maxspread) Submit(buy_choice,entry_choice,sl_choice,tp_choice,maxspread,tick);
}
