{
  "_note": "ตรวจกับ MetaTrader 5 MCP (XM Global, build 6230) แล้วเมื่อ 8 พ.ย. 2026 — ถ้า MCP อัปเดต ให้รัน python3 -m mt5kit probe ตรวจซ้ำ",
  "verified": true,
  "server": "terminal",
  "read": {
    "account": {
      "tool": "get_trading_account_info",
      "args": {}
    },
    "positions": {
      "tool": "get_trading_open_positions",
      "args": {
        "include_orders": true
      }
    },
    "symbols": {
      "tool": "get_marketwatch_symbols",
      "args": {}
    },
    "symbol_info": {
      "tool": "get_marketwatch_symbols",
      "args": {
        "symbol": "{symbol}",
        "include_hidden": true
      }
    },
    "history": {
      "tool": "get_chart_history",
      "args": {
        "symbol": "{symbol}",
        "period": "{tf}",
        "datetime_from": "{from}",
        "datetime_to": "{to}"
      }
    },
    "time": {
      "tool": "get_time_information",
      "args": {}
    },
    "calendar": {
      "tool": "economic_calendar_list_values",
      "args": {
        "datetime_from": "{from}",
        "datetime_to": "{to}",
        "limit": 5000
      }
    },
    "calendar_events": {
      "tool": "economic_calendar_list_events_by_currency",
      "args": {
        "currency_code": "{ccy}"
      }
    },
    "history_orders": {
      "tool": "get_trading_history_orders",
      "args": {
        "datetime_from": "{from}",
        "datetime_to": "{to}"
      }
    },
    "history_positions": {
      "tool": "get_trading_history_positions",
      "args": {
        "datetime_from": "{from}",
        "datetime_to": "{to}"
      }
    }
  },
  "timeframes": {
    "W1": "W1",
    "D1": "D1",
    "H4": "H4",
    "H1": "H1",
    "M15": "M15"
  },
  "time_format": "%Y-%m-%dT%H:%M:%S",
  "calendar_time_format": "%Y-%m-%dT%H:%M:%S",
  "trade_templates": {
    "_note": "ใช้โดยโมเดลเท่านั้น สคริปต์ห้ามเรียก · MCP นี้ไม่มีพารามิเตอร์ magic จึงระบุเจ้าของไม้ด้วย comment + ledger · expiration_time ใช้เวลาเซิร์ฟเวอร์ (ตรวจบน Demo ว่าโบรกเกอร์ตีความตรงก่อนใช้จริง)",
    "PLACE_PENDING": {
      "tool": "trade_send_pending_order",
      "args": {
        "symbol": "{symbol}",
        "type": "{order_type}",
        "volume": "{volume}",
        "price": "{price}",
        "sl": "{sl}",
        "tp": "{tp}",
        "expiration_type": "specified",
        "expiration_time": "{expiry_server}",
        "comment": "{comment}"
      }
    },
    "CANCEL_PENDING": {
      "tool": "trade_delete_order",
      "args": {
        "symbol": "{symbol}",
        "order_ticket": "{ticket}"
      }
    },
    "MODIFY_SL": {
      "tool": "trade_modify_sl_tp",
      "args": {
        "symbol": "{symbol}",
        "position_ticket": "{ticket}",
        "sl": "{sl}"
      }
    },
    "CLOSE_POSITION": {
      "tool": "trade_close_single_position",
      "args": {
        "symbol": "{symbol}",
        "position_ticket": "{ticket}"
      }
    }
  },
  "order_types": {
    "buy_limit": "buy_limit",
    "sell_limit": "sell_limit"
  }
}